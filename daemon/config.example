# Clawdmeter daemon config
#
# Copy this file to:
#   macOS / Linux : ~/.config/claude-usage-monitor/config
#   Windows       : %LOCALAPPDATA%\Clawdmeter\config
#
# The daemon re-reads it on every poll, so edits take effect within ~60s — no restart needed.

# Poll more than one Claude config dir and show whichever plan is currently
# active. Use this if you run separate plans from different config dirs (e.g. a
# personal plan in ~/.claude and a work plan in ~/.claude-work, selected via
# CLAUDE_CONFIG_DIR). Comma-separated; ~ is expanded.
#   - The daemon polls every listed dir each cycle and displays the plan whose
#     usage rose most recently (i.e. the one you're actively using). Before any
#     change is seen it shows the plan with the highest current usage.
#   - Unset (default) = just ~/.claude, unchanged single-plan behavior.
#   - install.sh can detect your ~/.claude* dirs and fill this in for you.
# config_dirs = ~/.claude, ~/.claude-work

# Play a sound on the device when your 5-hour session limit resets, so you know
# you can use Claude again without watching the screen.
#   off = silent (default)
#   on  = chime through the board speaker (boards with audio: AMOLED-2.16 / 1.8)
chime = off
# Show a clock on the Usage screen, in place of the "Usage" title.
#   off  = no clock; the screen keeps showing "Usage" (default)
#   auto = show the clock, auto-detecting 12h/24h from this machine's settings
#          (detection can default to 24h when the daemon runs under launchd/systemd
#           with no locale — set 12 or 24 explicitly below if auto guesses wrong)
#   12   = show the clock, forced 12-hour  (e.g. 6:28 PM)
#   24   = show the clock, forced 24-hour  (e.g. 18:28)
clock = off

# --- Live session awareness (optional) ---------------------------------------
# Show your open Claude Code chats on the device: what each one is doing, how
# full its context window is, and whether any of them is waiting on you.
# Off by default. Enabling it takes three things (see daemon/SESSIONS.md):
#   1. hook_port set below,
#   2. a hook block in each Claude config dir's settings.json
#      (install.sh offers to write it, or run:
#       daemon/clawdmeter_sessions.py --install-hooks ~/.claude/settings.json \
#           http://127.0.0.1:45999/),
#   3. the sidecar running (Linux: systemctl --user start clawdmeter-sessions;
#      Windows: install-windows.ps1 -Sessions does all three, and reads this
#      config from %LOCALAPPDATA%\Clawdmeter\config instead).

# Loopback port the hook listener serves on. Unset (default) = feature off:
# the sidecar exits and the daemon never sends session data.
# hook_port = 45999

# Pin the context window size in kilotokens (e.g. 200 or 1000) if you know it.
# Blank/unset = heuristic: 200k default, 1M on a [1m] model marker, snapping up
# to the next 1M multiple when observed usage exceeds the assumption. A pinned
# value is treated as fact and disables the snap-up.
# context_window_k =

# Byte budget for the session payload written to ~/.clawdmeter/sessions.json.
# The sidecar shrinks labels (8-char floor), then drops the least urgent rows
# until the payload fits. Keep below the BLE MTU the device negotiates; the
# default is conservative and fits 3-4 chat rows.
# sessions_budget_bytes = 180

# ---------------------------------------------------------------------------
# Agent reports (daemon/REPORT.md) — status check-ins from the fleet
# ---------------------------------------------------------------------------
# A cross-session message whose body opens with `CLAWDMETER-REPORT/1 STATE:
# summary` becomes a status card instead of an anonymous message row: the
# state drives the dot colour, the sort and the auto-jump. Anything that does
# not match the contract stays an ordinary message, unchanged.
#
# `off` reads report replies as the plain messages they are made of. The words
# still reach the panel; only the state colouring goes away.
# reports = on

# How long an agent report stays on the panel (seconds). Longer than a
# message's 180 s because a report is a snapshot you asked for -- but bounded,
# because the host cannot see the agent change its mind.
# report_expire_s = 300

# Report rounds want a bigger payload than the conservative default: ten
# agents can answer at once, the device draws six rows, and 500 bytes is what
# fits five reports plus the "+N MORE" marker in ONE ATT write at the 517-byte
# MTU the firmware requests. See daemon/REPORT.md for the arithmetic.
# sessions_budget_bytes = 500

# ---------------------------------------------------------------------------
# Remote fleet (daemon/FLEET.md) -- sessions on your OTHER machines
# ---------------------------------------------------------------------------
# Off by default. Needs an interactive `claude` login on this machine; an
# ANTHROPIC_API_KEY does not work. Run one producer at a time: this and the
# hook sidecar above write the same ~/.clawdmeter/sessions.json.
# fleet = off

# Show only the remote sessions that need a PERSON -- an agent stopped at a
# permission prompt, asking a question, or waiting for input. Idle and merely
# working sessions never reach the panel.
#
# `off` restores the full roster, which is what this used to be and what made
# it worth changing: nine rows, seven idle, two of them idle for five and seven
# DAYS. A list like that is not information on a device you read at a glance,
# and it crowds out the one row that mattered.
# fleet_attention_only = on

# How long the listing must fail CONTINUOUSLY before the device is told, in
# seconds. Below this the last good rows keep shipping (a blip must not blank a
# panel); above it the poller DROPS every row that came from the listing and
# sends one dim "FLEET DATA STALE" card in their place, saying why and how old
# the data is.
#
# 900 s is 30 consecutive poll failures, chosen against the common failure: the
# OAuth token lives about five hours and Claude Code refreshes the credential
# file itself, so a 401 usually heals on its own within a poll or two. Shouting
# on the first one would mean shouting several times a day about nothing. Set 0
# to mark the panel stale on the first failure.
# fleet_stale_after_s = 900
